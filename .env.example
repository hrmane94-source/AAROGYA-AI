# Gemini API Key for Arogya AI Clinical Assistant & Vision Report OCR
GEMINI_API_KEY=

# (Optional) Supabase Integration for Persistent Cloud Database
SUPABASE_URL=
SUPABASE_KEY=

# SMSLocal HTTP Gateway API Integration (for real mobile OTP authentication)
# API key obtained from SMSLocal dashboard (Settings > API Keys)
SMSLOCAL_API_KEY=
# Registered 6-character DLT Header / Sender ID (e.g. AROGYA)
SMSLOCAL_SENDER_ID=AROGYA
# Delivery route: 1 = Transactional (OTPs, 24x7, DND-exempt), 2 = Promotional
SMSLOCAL_ROUTE=1
# (Optional) 19-digit DLT Content Template ID approved under Principal Entity
SMSLOCAL_TEMPLATE_ID=
# (Optional) SMSLocal base API endpoint URL (defaults to https://app.smslocal.in/api)
SMSLOCAL_BASE_URL=https://app.smslocal.in/api
# (Optional) Template message override containing {#var#} placeholder
# SMSLOCAL_TEMPLATE_TEXT="Your Arogya AI verification OTP is {#var#}. Valid for 5 minutes."

